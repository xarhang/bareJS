{
  "name": "barejs",
  "version": "0.2.1",
  "author": "xarhang",
  "description": "Batteries-included web framework for Bun, Node.js, and Deno with O(1) JIT routing, TypeBox/Zod validation, OpenAPI 3.1, WebSockets, JSON-RPC 2.0, and built-in security.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./dist/index.js",
      "node": "./dist/node.js",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarhang/barejs.git"
  },
  "scripts": {
    "test": "bun test",
    "test:node": "NODE_OPTIONS=--expose-gc vitest run && node tests/node-smoke.mjs",
    "test:deno": "deno test --allow-all --unstable-sloppy-imports --no-check --v8-flags=--expose-gc --config deno.test.json --ignore=tests/playwright.test.ts,tests/production-db.test.ts tests/ && deno run --allow-net --allow-read --allow-write --allow-env tests/deno-smoke.ts",
    "benchs": "bun run benchmarks/index.ts",
    "bench": "bun run benchmarks/head-to-head.ts",
    "dev": "bun --watch Example/index.ts",
    "build": "bun ./scripts/build.ts",
    "prepublishOnly": "bun run build",
    "release": "bun run build && npm version patch && npm publish --access public"
  },
  "keywords": [
    "bun",
    "nodejs",
    "deno",
    "web-framework",
    "framework",
    "typescript",
    "batteries-included",
    "openapi",
    "swagger",
    "validation",
    "typebox",
    "zod",
    "websocket",
    "sse",
    "json-rpc",
    "type-safe",
    "security",
    "jit",
    "high-performance",
    "fastest",
    "barejs",
    "http-server"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@sinclair/typebox": "^0.34.46",
    "zod": "^3.0.0",
    "ws": "^8.0.0",
    "@node-rs/argon2": "^2.0.0",
    "bcryptjs": ""
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "@node-rs/argon2": {
      "optional": true
    },
    "bcryptjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.47",
    "@types/bun": "^1.3.5",
    "bcryptjs": "^2.4.3",
    "elysia": "latest",
    "hono": "latest",
    "mitata": "^1.0.34",
    "playwright-core": "^1.65.1",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "ws": "^8.0.0",
    "zod": "^3.25.76"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "llms.txt",
    "LICENSE"
  ]
}
